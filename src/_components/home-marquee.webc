<script webc:setup>
    function getTime() {
        return new Date().toLocaleString('en-US', { hour: 'numeric', minute: 'numeric', hour12: true })
    }
</script>
<div class="home-hero__marquee" data-marquee>
    <div class="home-hero__marquee-inner" data-marquee-inner>
        <div class="tidal-widget">
            <social-icon @icon="tidal" class="tidal-widget__icon"></social-icon>
            <div webc:if="recentListening && recentListening.url" class="tidal-widget__inner">
                <a class="tidal-widget__track" :href="recentListening.url" @text="recentListening.name"></a>,
                <span class="tidal-widget__artists" @text="recentListening.artists"></span>
            </div>
        </div>
        <span>—</span>
        <span class="home-hero__marquee-locale">48ºF @ N 39º 43’ 31.56” W 104º 58’ 0.94”
            (Denver, Colorado)</span>
        <span>—</span>
        <span class="home-hero__marquee-time" data-tag="currentTime" @text="`${getTime()}`">11:03AM</span>
        <span>—</span>
    </div>
</div>