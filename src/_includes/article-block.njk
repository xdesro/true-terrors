{% macro articleBlock(article, isFeatured = false, isHero = false) %}
<article class="article-block{% if isFeatured %} article-block--featured themed dark{% endif %}{% if article.data.cardTheme %} themed article-block--themed article-block--{{ article.data.cardTheme }}{% endif %}{% if isHero %} article-block--hero{% endif %}">
    <dl class="article-block__meta">
        <div>
            <dt class="visually-hidden">Category</dt>
            <dd>{{- article.data.category -}}</dd>
        </div>
        <div>
            <dt class="visually-hidden">Tags</dt>
            <dd>
                {%- for topic in article.data.topics -%}
                    {{- topic -}} {%- if not loop.last %} | {% endif %}
            {%- endfor -%}
            </dd>
        </div>
    </dl>
    <h1 class="article-block__title">{% if article.data.cardTheme %}{% include "graphics/card-titles/" + article.data.cardTheme + ".svg" %}{% else %}{{ article.data.title }}{% endif %}</h1>
    {% if isHero and article.data.subtitle %}
        <p class="article-block__description">{{ article.data.subtitle }}</p>
    {% endif %}
    <dl class="article-block__meta">
        <div>
            <dt class="visually-hidden">Reading Time</dt>
            <dd>{{ article.data.readTime }}</dd>
        </div>
        <div>
            <dt class="visually-hidden">Last updated</dt>
            <dd>
                {# <time>Last updated 
                    {% if article.data.publishDate %}
                        {{ article.data.publishDate | humanReadableDate }}
                    {% elseif article.date %}
                        {{ article.date | humanReadableDate }}
                    {% endif %}
                </time> #}
            </dd>
        </div>
    </dl>
    <a class="article-block__link" href="/writing/{% if article.data.slug %}{{ article.data.slug | slugify }}{% else %}{{ article.data.title | slugify }}{% endif %}" {% if article.data.withoutTransition %}data-taxi-ignore{% endif %}>Read more →</a>
</article>
{% endmacro %}
